<section class="hero" id="top">
    <div class="hero__inner container">
        <div>
            <p class="eyebrow">Birkenhead · Wirral · North West</p>
            <h1 class="hero__title">Solar, heat pumps &amp; <em>everything electrical.</em></h1>
            <p class="lead lead--on-navy">GB Electrical is an NICEIC approved contractor with over 20 years’ experience. We help homes and businesses across the North West generate their own power, heat more efficiently and stay safe.</p>
            <div class="hero__actions">
                <a class="btn btn--primary" href="#contact">Get a free solar quote</a>
                <a class="btn btn--ghost" href="@Site.PhoneHref">Call @Site.PhoneDisplay</a>
            </div>
            <ul class="hero__checks">
                <li><Icon Name="check" Size="20" StrokeWidth="2.6" />NICEIC approved</li>
                <li><Icon Name="check" Size="20" StrokeWidth="2.6" />Domestic &amp; commercial</li>
                <li><Icon Name="check" Size="20" StrokeWidth="2.6" />Our own installation team</li>
            </ul>
        </div>

        <div class="hero__visual">
            <div class="hero__badge" aria-hidden="true"><b>20+</b><span>years’<br>experience</span></div>
            <div class="hero__photo hero__photo--main">
                <img src="img/work/medicinema-1.jpg" alt="Red feature wall with LED strip lighting installed by GB Electrical at MediCinema, Alder Hey" width="1600" height="1200" fetchpriority="high">
            </div>
            <div class="hero__photo hero__photo--sub">
                <img src="img/work/medicinema-entrance.jpg" alt="MediCinema entrance with green LED lighting at Alder Hey" width="1600" height="1200">
            </div>
            <p class="hero__tag"><strong>Recent project</strong>Feature lighting for MediCinema at Alder Hey Children’s Hospital</p>
        </div>
    </div>
</section>
