@* Inline SVG icons from the static build. Decorative only (aria-hidden). *@
<svg width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="@(Filled ? "currentColor" : "none")"
     stroke="@(Filled ? null : "currentColor")"
     stroke-width="@(Filled ? null : StrokeWidth)"
     stroke-linecap="@(Filled ? null : "round")"
     stroke-linejoin="@(Filled ? null : "round")"
     aria-hidden="true">
    @switch (Name)
    {
        case "check": <path d="M20 6 9 17l-5-5" /> break;
        case "phone": <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z" /> break;
        case "menu": <path d="M4 7h16M4 12h16M4 17h16" /> break;
        case "clock": <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /> break;
        case "building": <path d="M3 21h18M5 21V8l7-5 7 5v13" /><path d="M9 21v-6h6v6" /> break;
        case "clipboard": <rect x="5" y="3" width="14" height="18" rx="2" /><path d="M9 3v2h6V3" /><path d="m9 13 2 2 4-4" /> break;
        case "solar": <path d="M3 20h18" /><path d="m5 16 2-8h10l2 8z" /><path d="M6 12h12M10 8l-1 8M14 8l1 8" /><path d="M12 2v2M5.6 4.6l1 1M18.4 4.6l-1 1" /> break;
        case "heat-pump": <rect x="2" y="5" width="20" height="14" rx="2" /><circle cx="9" cy="12" r="4" /><path d="M9 8v8M5 12h8M16 9h3M16 12h3M16 15h3" /> break;
        case "pulse": <path d="M3 12h4l3-8 4 16 3-8h4" /> break;
        case "shield": <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z" /><path d="m9 12 2 2 4-4" /> break;
        case "bulb": <path d="M9 18h6M10 21h4" /><path d="M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z" /> break;
        case "mail": <rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /> break;
        case "facebook": <path d="M14 8h3V4h-3c-2.8 0-4.5 1.8-4.5 4.6V11H7v4h2.5v7h4v-7h3l.5-4h-3.5V8.8c0-.5.3-.8.5-.8z" /> break;
        case "plus": <path d="M12 5v14M5 12h14" /> break;
        case "chevron-left": <path d="m15 18-6-6 6-6" /> break;
        case "chevron-right": <path d="m9 18 6-6-6-6" /> break;
        case "close": <path d="M18 6 6 18M6 6l12 12" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 24;
    [Parameter] public string StrokeWidth { get; set; } = "2";

    private bool Filled => Name == "facebook";
}
